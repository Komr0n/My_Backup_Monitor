<Window x:Class="BackupMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupMonitor"
        Title="Backup Monitor" Height="720" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource FontFamilyDefault}"
        FontSize="{StaticResource FontSizeMedium}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА: заголовок + переключатель темы -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Backup Monitor" FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" Name="BtnToggleTheme" Width="42" Height="42"
                    Click="BtnToggleTheme_Click" ToolTip="Переключить тему"
                    Style="{StaticResource SecondaryButtonStyle}"
                    FontSize="18" Padding="0">
                <TextBlock Name="ThemeIcon" Text="☀" FontSize="18"/>
            </Button>
        </Grid>

        <!-- TOOLBAR: кнопки действий (WrapPanel переносит на след. строку) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="10">
            <WrapPanel Orientation="Horizontal">
                <Button Name="BtnCheckToday" Content="✔ Проверить сегодня" Margin="0,0,8,8"
                        Style="{StaticResource PrimaryButtonStyle}" Click="BtnCheckToday_Click"/>
                <Button Name="BtnCheckPeriod" Content="📅 Период" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnCheckPeriod_Click"/>
                <Button Name="BtnAddService" Content="➕ Сервис" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnAddService_Click"/>
                <Button Name="BtnAddGroup" Content="➕ Группа сервисов" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnAddGroup_Click"/>
                <Button Name="BtnEditService" Content="✏ Редактировать" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnEditService_Click"/>
                <Button Name="BtnDeleteService" Content="🗑 Удалить" Margin="0,0,8,8"
                        Style="{StaticResource DangerButtonStyle}" Click="BtnDeleteService_Click"/>
                <Button Name="BtnSaveReport" Content="💾 Сохранить отчёт" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnSaveReport_Click"/>
                <Button Name="BtnTelegramSettings" Content="✈ Telegram" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnTelegramSettings_Click"/>
                <Button Name="BtnSendReport" Content="📤 Отправить отчёт" Margin="0,0,0,8"
                        Style="{StaticResource PrimaryButtonStyle}" Click="BtnSendReport_Click"/>
            </WrapPanel>
        </Border>

        <!-- КАРТОЧКА СТАТУСА СЛУЖБЫ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Name="ServiceStatusDot" Width="14" Height="14"
                         Fill="{DynamicResource StatusDefault}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Служба:" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeNormal}" Margin="0,0,8,0"/>
                    <TextBlock Name="ServiceStatusText" Text="Не установлена" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeNormal}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Name="BtnInstallService" Content="📦 Установить" Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="BtnInstallService_Click"/>
                    <Button Name="BtnStartService" Content="▶ Запустить" Margin="0,0,6,0"
                            Style="{StaticResource PrimaryButtonStyle}" Click="BtnStartService_Click"/>
                    <Button Name="BtnStopService" Content="⏹ Остановить" Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="BtnStopService_Click"/>
                    <Button Name="BtnRefreshServiceStatus" Content="⟳" Width="40" Padding="0"
                            Style="{StaticResource SecondaryButtonStyle}" ToolTip="Обновить статус"
                            Click="BtnRefreshServiceStatus_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- СПИСОК СЕРВИСОВ -->
        <TreeView Name="ServicesTreeView"
                  Grid.Row="3"
                  Margin="0,0,0,0"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderThickness="0"
                  SelectedItemChanged="ServicesTreeView_SelectedItemChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.Resources>
                <Style x:Key="StatusIndicatorStyle" TargetType="Border">
                    <Setter Property="Width" Value="12"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Background" Value="{DynamicResource StatusDefault}"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="OK">
                            <Setter Property="Background" Value="{DynamicResource StatusOk}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="WARNING">
                            <Setter Property="Background" Value="{DynamicResource StatusWarning}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="FAIL">
                            <Setter Property="Background" Value="{DynamicResource StatusFail}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="ERROR">
                            <Setter Property="Background" Value="{DynamicResource StatusError}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="OK">
                            <Setter Property="Foreground" Value="{DynamicResource StatusOk}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="WARNING">
                            <Setter Property="Foreground" Value="{DynamicResource StatusWarning}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="FAIL">
                            <Setter Property="Foreground" Value="{DynamicResource StatusFail}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="ERROR">
                            <Setter Property="Foreground" Value="{DynamicResource StatusError}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:ServiceNodeViewModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Vertical" Margin="6,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatusIndicatorStyle}"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeMedium}" Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource FontPath}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="20,2,0,0"/>
                        <TextBlock Text="{Binding Details}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="20,2,0,0"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="▶ Проверить этот сервис" Click="MenuItemCheckSelected_Click"/>
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>

        <!-- СТАТУС-БАР -->
        <Border Grid.Row="4" Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8" Margin="-16,-8,-16,-16">
            <TextBlock Name="StatusText" Text="Готов"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSmall}"/>
        </Border>
    </Grid>
</Window>
