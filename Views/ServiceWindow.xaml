<Window x:Class="BackupMonitor.Views.ServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка сервиса" Height="680" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource FontFamilyDefault}"
        FontSize="{StaticResource FontSizeNormal}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Название сервиса:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBox Name="TxtServiceName" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="Путь к папке с бэкапами:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxtPath" Style="{StaticResource TextBoxStyle}" Grid.Column="0" Margin="0,0,8,0"/>
                <Button Name="BtnBrowse" Content="📂 Обзор..." Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowse_Click"/>
            </Grid>

            <TextBlock Text="Ключевые слова (через запятую, опционально):" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBox Name="TxtKeywords" Height="60" Margin="0,0,0,12"
                     Style="{StaticResource TextBoxStyle}"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Маска файлов (например *.bak, опционально):" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBox Name="TxtFileMask" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="Режим проверки:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <ComboBox Name="CmbCheckMode" Height="28" SelectionChanged="CmbCheckMode_SelectionChanged" Margin="0,0,0,12">
                <ComboBoxItem Content="По имени файла (regex)" Tag="NameDate"/>
                <ComboBoxItem Content="По дате файла" Tag="FileTime"/>
            </ComboBox>

            <StackPanel Name="RegexPanel" Margin="0,0,0,12">
                <TextBlock Text="Регулярные выражения для извлечения даты (по одному на строку):" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <TextBox Name="TxtDatePatterns" Height="100"
                         Style="{StaticResource TextBoxStyle}"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <StackPanel Name="FileTimePanel" Margin="0,0,0,12">
                <TextBlock Text="Источник времени файла:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                <ComboBox Name="CmbFileTimeSource" Height="28">
                    <ComboBoxItem Content="LastWriteTime" Tag="LastWriteTime"/>
                    <ComboBoxItem Content="CreationTime" Tag="CreationTime"/>
                </ComboBox>
            </StackPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ожидаемый день (0 = сегодня, 1 = вчера):" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <TextBox Name="TxtExpectedDayOffset" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Минимум файлов за день:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <TextBox Name="TxtMinFilesPerDay" Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Минимальный размер файла (байт, 0 = не проверять):" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBox Name="TxtMinFileSizeBytes" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Файлы меньше указанного размера считаются некорректными бэкапами."
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Name="BtnSave" Content="💾 Сохранить" Width="130"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button Name="BtnCancel" Content="Отмена" Width="100"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
