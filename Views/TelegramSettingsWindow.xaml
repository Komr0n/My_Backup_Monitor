<Window x:Class="BackupMonitor.Views.TelegramSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Telegram уведомлений" Height="680" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource FontFamilyDefault}"
        FontSize="{StaticResource FontSizeNormal}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Включить Telegram -->
            <CheckBox Name="ChkEnabled" Content="✈ Включить отправку в Telegram"
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"
                      Checked="ChkEnabled_Checked" Unchecked="ChkEnabled_Unchecked"/>

            <!-- Bot Token -->
            <TextBlock Text="Bot Token:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBox Name="TxtBotToken" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Получите у @BotFather через /newbot"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

            <!-- Chat ID -->
            <TextBlock Text="Chat ID:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBox Name="TxtChatId" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Для группы должен начинаться с минуса (например: -1003441795211)"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

            <!-- Тип отчёта -->
            <TextBlock Text="Тип отчёта:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="10">
                <StackPanel IsEnabled="{Binding ElementName=ChkEnabled, Path=IsChecked}">
                    <RadioButton Name="RbFailOnly" Content="📤 Только FAIL" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}" Checked="ReportMode_Checked"/>
                    <RadioButton Name="RbOkOnly" Content="✅ Только OK" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}" Checked="ReportMode_Checked"/>
                    <RadioButton Name="RbFull" Content="📋 Полный отчёт (OK + FAIL)" Margin="0,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Checked="ReportMode_Checked"/>
                </StackPanel>
            </Border>

            <!-- Время отправки -->
            <TextBlock Text="Время отправки (формат HH:mm, каждое на новой строке):" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBox Name="TxtSendTimes" Height="80"
                     Style="{StaticResource TextBoxStyle}"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     IsEnabled="{Binding ElementName=ChkEnabled, Path=IsChecked}" Margin="0,0,0,14"/>

            <!-- Интерактивные команды -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,1,1,1">
                <StackPanel>
                    <TextBlock Text="🤖 Интерактивные команды бота" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" FontSize="{StaticResource FontSizeMedium}" Margin="0,0,0,8"/>
                    <CheckBox Name="ChkEnableCommands" Content="Включить команды (/report, /check, /services)"
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Разрешённые Chat ID (через запятую, для авторизации):" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                    <TextBox Name="TxtAllowedChatIds" Style="{StaticResource TextBoxStyle}" Height="50"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>
                    <TextBlock Text="Оставьте пустым, если бот должен отвечать любому пользователю."
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Name="BtnSave" Content="💾 Сохранить" Width="130"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button Name="BtnCancel" Content="Отмена" Width="100"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
