<Window x:Class="BackupMonitor.Views.ServiceSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор сервиса" Height="210" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource FontFamilyDefault}"
        FontSize="{StaticResource FontSizeNormal}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите сервис для проверки периода"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

        <ComboBox Name="ServiceCombo" Grid.Row="1" Height="28" Margin="0,0,0,10"
                  Style="{StaticResource {x:Type ComboBox}}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="✔ OK" Width="100"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" Width="100"
                    Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
